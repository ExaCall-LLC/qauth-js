{
  "name": "@isdlc.ai/qauth",
  "version": "0.23.0",
  "description": "Server-side SDK for products that use qAuth: verify access tokens offline, protect routes (middleware), check permissions with a cache, act as the signed-in person (their organizations, members, roles, domains, API keys, audit) and validate API keys.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-force-exit test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "publishConfig": {
    "registry": "https://git.qapps.dev/api/packages/isdlc/npm/"
  },
  "dependencies": {
    "jose": "6.1.0"
  }
}
